# Copy to .env.local for local development — NEVER commit .env.local to git.
# In production set these in the Vercel dashboard:
#   Project → Settings → Environment Variables

# Vite exposes only VITE_* variables to the browser bundle.

# Local dev:  http://localhost:8001
# Production: https://darukaa-backend.onrender.com  (your Render service URL)
VITE_API_BASE_URL=http://localhost:8001

# Mapbox public token — https://account.mapbox.com/access-tokens/
# Required scopes: styles:read, tiles:read, geocoding:read
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
