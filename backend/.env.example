# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Render Postgres:   postgresql+asyncpg://user:pass@hostname:5432/dbname
# Supabase:         postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/darukaa

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_to_a_64_char_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed origins (no trailing slashes)
CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
